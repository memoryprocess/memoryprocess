{
  "release-type": "node",
  "versioning": "prerelease",
  "prerelease-type": "dev",
  "prerelease": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    "packages/bindings": {
      "package-name": "@memoryprocess/bindings",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/core": {
      "package-name": "@memoryprocess/core",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/cli": {
      "package-name": "@memoryprocess/cli",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/mcp": {
      "package-name": "@memoryprocess/mcp",
      "changelog-path": "CHANGELOG.md"
    }
  },
  "plugins": ["node-workspace"],
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json"
}
