{
  "name": "@memoryprocess/core",
  "version": "0.0.1",
  "description": "Windows process-memory engine: typed read/write, CE-style scanning, MinHook-grade hooks, inject, threads, findWhatWrites, remote structs (Address/Entity/Offsets). Built on @memoryprocess/bindings.",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "build:victim": "node scripts/build-victim.mjs",
    "build:testdll": "node scripts/build-testdll.mjs",
    "check": "bun check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "clean": "node scripts/clean.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memoryprocess/memoryprocess.git",
    "directory": "packages/core"
  },
  "author": "JoShMiQueL",
  "license": "MIT",
  "dependencies": {
    "@memoryprocess/bindings": "workspace:*"
  },
  "keywords": [
    "memory",
    "process",
    "read",
    "write",
    "windows",
    "native",
    "addon",
    "napi",
    "pattern-scan",
    "reverse-engineering"
  ]
}
