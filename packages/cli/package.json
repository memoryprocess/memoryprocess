{
  "name": "@memoryprocess/cli",
  "version": "0.0.3-beta.3",
  "description": "mproc - command-line interface for the memoryprocess toolkit (scan/read/write/pointers/watch with --json).",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "bin": {
    "mproc": "./dist/cli.mjs"
  },
  "exports": {
    ".": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "check": "bun check",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@memoryprocess/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memoryprocess/memoryprocess.git",
    "directory": "packages/cli"
  },
  "author": "JoShMiQueL",
  "license": "MIT",
  "keywords": [
    "memory",
    "process",
    "cli",
    "windows",
    "pattern-scan",
    "reverse-engineering"
  ]
}
